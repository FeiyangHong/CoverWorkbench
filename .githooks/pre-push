#!/bin/sh
# Check every published ref, including tags and historical commits.
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python tools/release_check.py --for-public-release --ref "$local_oid" || exit 1
done
